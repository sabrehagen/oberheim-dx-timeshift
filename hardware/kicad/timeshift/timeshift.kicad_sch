	(text "DX TimeShift rev A  -  snare delay interposer for the Oberheim DX" (exclude_from_sim no) (at 20.32 19.05 0) (effects (font (size 3.0 3.0) (bold yes)) (justify left top)) (uuid "b420ed0a-3aa5-5a22-976e-9ddd85805617"))
	(text "Fits Oberheim DX processor board 1721A (U701).  NOT for DXa (board 1906, U715: snare lines are on U715 pins 7/5/2).\nUNPLUG NANO BEFORE USB: flash the Nano OUT of the board, or only with the DX switched on (the Nano 5V pin is the DX logic rail).\nImplements PROJECT_BRIEF.md 3.5 (LOCKED). Signal facts: docs/research/dx-findings.md sections b, c, d, h." (exclude_from_sim no) (at 20.32 29.21 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "9a64d739-ca69-5cf9-a8c9-4656cc458614"))
