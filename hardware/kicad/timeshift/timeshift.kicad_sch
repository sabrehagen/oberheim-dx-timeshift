	(text "74HC157: I0x = input A (bypass), I1x = input B (delayed),\nZx = output Y.  S LOW = A = bypass (R5 pulls S low when the Nano\nis off / in reset / unprogrammed), S HIGH = B = delayed replay.\nChannel 1 = RST2, 2 = FFA2, 3 = FFB2, 4 unused (inputs to GND)." (exclude_from_sim no) (at 175.26 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4d2cb965-0f16-51e6-b338-9e8c3221d765"))
